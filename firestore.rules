rules_version = '2';

// ⚠️ אזור ליבה. CLAUDE.md.
//
// חוק הרשאות אינו מאומת בקריאה שלו. הוא מאומת בניסיון כתיבה שאמור להיכשל,
// ובראייה שהוא נכשל. DOCS/PLANING/VERIFICATION-BUDGET.md
//
// ✅ נבדק מול אמולטור Firestore, 68 בדיקות, כולן עוברות.
// ⚠️ ו-24 מהן על אוסף `events`, שהוא אזור ליבה: מי כותב, על שמו, סכמה סגורה,
//    ושאין עדכון ואין מחיקה. test/rules/events.test.mjs
// ⚠️ שונה אחרי הפריסה של 05/10: פתיחת סלון כטננט, ותביעת המערכת, וסריקת
//    החברים שצומצמה למנהלות. צריך להדביק שוב.
//
// ⚠️ ופריסה אינה עולה עם Netlify. כל שינוי כאן נפרס בנפרד:
//      firebase deploy --only firestore:rules --project hasalon-dev

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /**
     * ⚠️⚠️ מי מורשה לפתוח סלון חדש.
     *
     * בלי זה כל מי שנכנס ב-Google יכול לפתוח סלון במסד של העמותה, והוא
     * המנהל שלו. זה היה פתוח, וזו הייתה טעות.
     *
     * האוסף נכתב בקונסולה בלבד, ואין דרך להוסיף לו מתוך האפליקציה.
     * DOCS/PLANING/20-who-may-open-a-salon.md
     */
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function memberDoc(branchId) {
      return get(/databases/$(database)/documents/branches/$(branchId)/members/$(request.auth.uid));
    }

    function isMember(branchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/branches/$(branchId)/members/$(request.auth.uid));
    }

    function isActive(branchId) {
      return isMember(branchId) && memberDoc(branchId).data.status == 'active';
    }

    function isManager(branchId) {
      return isActive(branchId) && memberDoc(branchId).data.role == 'manager';
    }

    /**
     * ⚠️⚠️ מסמך אחד, והוא הדלת. `system/bootstrap`.
     *
     * הבעיה: מנהל העל הוא אדם, והמסד אינו יודע מי הוא. כניסה ב-Google מזהה
     * ואינה מקנה כלום, ולכן צריך פעם אחת לומר למערכת מי מפעיל אותה.
     *
     * הפתרון: הראשון שנכנס תובע את המערכת, ובאותה אצווה נוצר המסמך הזה.
     * מהרגע שהוא קיים `exists` נכון, והתביעה נחסמת לעולם. `update` ו-`delete`
     * אסורים, ולכן אי אפשר לפתוח את הדלת שוב, גם לא בטעות.
     *
     * ⚠️ והמשמעות: מי שנכנס ראשון הוא מנהל העל. זה חלון מירוץ, והוא נסגר
     * בתביעה הראשונה. DOCS/PLANING/21-nobody-told-the-database-who-the-owner-is.md
     */
    match /system/{docId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && docId == 'bootstrap'
        && request.resource.data.claimedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ⚠️ כל אחד קורא את הרשומה של עצמו, כדי שהממשק ידע אם להציג פתיחת סלון.
    match /platformAdmins/{adminId} {
      allow get: if signedIn() && adminId == request.auth.uid;
      allow list: if false;

      // ⚠️ תביעת המערכת, ורק כשעוד לא נתבעה. זו המחצית השנייה של החוק
      // שיושב על `system/bootstrap`, ושתיהן תלויות זו בזו.
      allow create: if signedIn()
        && adminId == request.auth.uid
        && !exists(/databases/$(database)/documents/system/bootstrap)
        && getAfter(/databases/$(database)/documents/system/bootstrap)
             .data.claimedBy == request.auth.uid;

      // ⚠️ ואין עדכון ואין מחיקה. מנהל על נוסף נוסף בקונסולה בלבד.
      allow update, delete: if false;
    }

    match /branches/{branchId} {
      // כל מי שמחובר קורא את רשימת הסלונים ואת מסמך הסלון. בלי זה אין מסך
      // בחירה, ואי אפשר לבקש להצטרף לסלון שעוד אינך חבר בו.
      // ⚠️ מסמך הסלון מחזיק שעות, חללים וקוד ICS, ואינו מחזיק מידע אישי.
      // המידע האישי יושב באוסף members, והוא סגור לחברי הסלון בלבד.
      allow read: if signedIn();

      // ⚠️⚠️ פתיחת סלון היא כתיבה אחת של שני מסמכים, ולא שתיים בזו אחר זו.
      //
      // הבעיה: מי שפותח סלון חייב להיות המנהל שלו, אחרת אין בו אף אחד שיאשר
      // חברים, ואין דרך להגדיר מנהל בלי מנהל. וההפך מסוכן: אם מותר לכתוב
      // לעצמך role: manager, כל מי שנרשם הופך למנהל של כל סלון.
      //
      // הפתרון: `getAfter` בודק את המצב אחרי שהאצווה כולה נכתבה. כאן הוא
      // דורש שבאותה אצווה שיוצרת את הסלון נוצר גם המנהל שלו, והוא הכותב.
      // ובכיוון השני, ב-members, מותר ליצור את עצמך כמנהל רק כשהסלון עצמו
      // עוד לא היה קיים לפני האצווה.
      //
      // ⚠️ ושתי השורות האלה תלויות זו בזו. שינוי באחת בלי השנייה פותח חור.
      // DOCS/PLANING/18-each-salon-is-a-tenant.md
      // ⚠️ ושלושה תנאים ולא שניים. `isPlatformAdmin` הוא מי מורשה בכלל,
      // ושני האחרים הם שמי שפותח נכתב כמנהל באותה אצווה.
      allow create: if isPlatformAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/branches/$(branchId)/members/$(request.auth.uid))
             .data.role == 'manager';

      allow update: if isManager(branchId);
      allow delete: if false;

      match /members/{memberId} {
        // ⚠️ `get` ו-`list` בנפרד, וזה לא קוסמטי.
        //
        // בכניסה הראשונה האפליקציה קוראת את רשומת החבר של עצמה כדי לבדוק אם
        // היא קיימת. עם `allow read: if isMember(...)` הקריאה הזו נדחית תמיד,
        // כי isMember דורש שהרשומה כבר תהיה קיימת. ביצה ותרנגולת: אי אפשר
        // להיכנס בפעם הראשונה לעולם.
        //
        // לכן: כל מי שמחובר קורא את הרשומה של עצמו, קיימת או לא.
        allow get: if signedIn() && (memberId == request.auth.uid || isMember(branchId));

        // ⚠️⚠️ סריקת החברים למנהלות בלבד, ובהכרעת בעל המוצר 06/10.
        //
        // קודם זה היה `isMember`, בהכרעה "חבר רואה את כולם". בפועל רשומת החבר
        // מחזיקה מייל, ולכן המייל של כל חבר היה קריא לכל חבר אחר ישירות
        // מהמסד. בלשון בעל המוצר: "אין צורך שיהיה גלוי, כי אין בזה שימוש."
        //
        // ⚠️ ומה שחבר כן רואה לא נפגע: השם של מי שמשובץ יושב על המשמרת עצמה
        // כ-`assigneeName`, ולא נקרא מאוסף החברים.
        allow list: if isManager(branchId);

        // ⚠️ חבר יוצר את רשומת עצמו בלבד, והוא חייב ליצור אותה כ-pending
        // ובתפקיד member. בלי שתי הבדיקות האלה כל מי שנרשם היה יכול לכתוב
        // לעצמו role: manager ולקבל את כל המסד.
        //
        // ⚠️⚠️ והחריג היחיד: מי שפותח סלון חדש. הוא נכתב כמנהל פעיל, ורק
        // באצווה שיוצרת סלון שעוד לא היה קיים. `exists` משקף את המצב לפני
        // האצווה, ולכן על סלון קיים התנאי שקרי תמיד, ואי אפשר למנות את עצמך
        // בו. זו המחצית השנייה של החוק שיושב על מסמך הסלון למעלה.
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && (
            (request.resource.data.status == 'pending' && request.resource.data.role == 'member')
            || (
              isPlatformAdmin()
              && request.resource.data.status == 'active'
              && request.resource.data.role == 'manager'
              && !exists(/databases/$(database)/documents/branches/$(branchId))
              && getAfter(/databases/$(database)/documents/branches/$(branchId))
                   .data.createdBy == request.auth.uid
            )
          );

        // מנהלת מאשרת ומשנה תפקיד.
        //
        // ⚠️ ומנהל המערכת גם הוא, וזו הדרך להגדיר את המנהלת הראשונה של סלון
        // שנוצר לפני שהחוק הזה היה קיים. בלעדיה היא נקבעת ביד בקונסולה.
        allow update: if isManager(branchId) || isPlatformAdmin();
        allow delete: if false;
      }

      match /shifts/{shiftId} {
        allow read: if isMember(branchId);

        // רק מנהלת מולידה חודש ומוחקת.
        allow create: if isManager(branchId);
        allow delete: if false;

        // ⚠️ חבר פעיל מעדכן משמרת, והכללים שמגבילים אותו לשיבוץ של עצמו
        // יושבים כרגע בשכבת השירות ולא כאן. רשומה 15.
        allow update: if isActive(branchId) || isManager(branchId);
      }

      match /activityDays/{dayId} {
        allow read: if isMember(branchId);
        allow write: if isManager(branchId);
      }

      /**
       * ⚠️⚠️ אזור ליבה. הרשומה שנכתבת ואינה נמחקת, שאומרת מי עשה מה ומתי.
       *
       * DOCS/PLANING/29-nothing-records-that-someone-cancelled.md
       *
       * ⚠️ ואין לדבר הזה שם במוצר, כי אין לו שורה ב-DOCS/GLOSSARY.md.
       *
       * ארבעה דברים נאכפים כאן, וכל אחד מהם הוא הגנה אחרת:
       *
       *   1. מי כותב. חבר פעיל בסניף, או מנהל המערכת. ⚠️ ומנהל המערכת ולא
       *      רק חבר פעיל, כי הוא מאציל תפקידים בסלון שאינו חבר פעיל בו, וזו
       *      בדיוק פעולה שחייבת להיכתב. בלי התוספת הזו ההאצלה שלו נדחית
       *      כולה, כי השורה נכתבת באותה אצווה.
       *
       *   2. על שמו. `actorMemberId` חייב להיות הכותב, ולכן אי אפשר לכתוב
       *      שורה בשם אדם אחר.
       *
       *   3. ⚠️⚠️ סכמה סגורה. `hasOnly` מגדיר את תשעת השדות, ו-`action`
       *      ו-`detail` מוגבלים לרשימות. בלי זה `action` הוא מחרוזת חופשית,
       *      וכל אחד יכול לכתוב משפט על אדם אחר לתוך שורה שנשמרת 12 חודשים.
       *      ⚠️ וזה הכלל שאינו ניתן לאכיפה בקוד האפליקציה, כי כתיבה ישירה
       *      למסד עוקפת אותו. כאן הוא נאכף.
       *
       *   4. ⚠️⚠️ אין עדכון ואין מחיקה, גם למנהלת. שורה שמי שנמצא בה יכול
       *      למחוק ממנה אינה ראיה, והמנהלת היא בדיוק מי שהשורה מתעדת
       *      כשהיא מחליפה קוד או משנה הרשאות.
       *
       * ⚠️ והמחיקה היחידה היא תפוגה, ואינה חוק: מדיניות `TTL` על `expiresAt`,
       * 12 חודשים, ב-`firestore.indexes.json`. ⚠️ ולכן `expiresAt` חייב להיות
       * חותמת זמן, ונאכף כאן: מדיניות תפוגה על שדה מספרי אינה מוחקת דבר.
       */
      match /events/{eventId} {
        allow create: if (isActive(branchId) || isPlatformAdmin())
          && request.resource.data.actorMemberId == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'at', 'expiresAt', 'actorMemberId', 'action',
               'shiftId', 'shiftDate', 'subjectMemberId', 'detail', 'count'
             ])
          && request.resource.data.keys().hasAll([
               'at', 'expiresAt', 'actorMemberId', 'action'
             ])
          && request.resource.data.at is number
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.action in [
               'shiftAssigned', 'shiftReleased', 'handoverRequested',
               'handoverCancelled', 'handoverTaken', 'attendanceSet',
               'memberApproved', 'memberRejected', 'memberDeactivated',
               'memberReactivated', 'roleChanged',
               'accessCodeSet', 'settingsChanged', 'monthCreated', 'importRan'
             ]
          && (
            !request.resource.data.keys().hasAny(['detail'])
            || request.resource.data.detail in [
                 'assumed', 'confirmed', 'noShow', 'cancelled',
                 'member', 'manager',
                 'name', 'openingHours', 'shiftTemplates', 'spaces', 'importIgnore'
               ]
          )
          && (
            !request.resource.data.keys().hasAny(['count'])
            || request.resource.data.count is number
          );

        allow update, delete: if false;

        /*
          ⚠️⚠️ וכאן הפער שנשאר פתוח בהכרעת בעל המוצר 12/10, סעיף 1.
          `list` למנהלת בלבד, וחוקי Firestore אינם בודקים את תנאי השאילתה,
          ולכן גם שאילתה שחבר מסנן לעצמו נדחית. כלומר חבר אינו יכול לראות
          את מה שנרשם עליו, וזה סותר את כלל הפרטיות השלישי באותה רשומה.
          ⚠️ וההבטחה נאמרת במילים במסך הפרטיות במקום להישאר שבורה בשקט.
          DOCS/PLANING/30-a-member-cannot-read-their-own-record.md
        */
        allow get: if isManager(branchId)
          || (signedIn() && resource.data.actorMemberId == request.auth.uid);
        allow list: if isManager(branchId);
      }

      // ⚠️⚠️ כאן יושב החור היחיד שידוע מראש, והוא הפיצ'ר המרכזי.
      //
      // הכלל במוצר: הקוד נחשף רק למי שמשובץ לפחות למשמרת אחת בחודש.
      //
      // חוק מסד אינו יכול לבדוק את זה. הזכאות היא שאילתה על אוסף המשמרות,
      // וחוקי Firestore יודעים לקרוא מסמך בודד ואינם יודעים לשאול אוסף.
      //
      // מה שהשורה הבאה אומרת בפועל: כל חבר פעיל יכול לקרוא את הקוד ישירות
      // מהמסד, גם אם אינו משובץ החודש. הסינון שבאפליקציה הוא בממשק בלבד.
      //
      // ⚠️ כלומר התנאי שהמוצר כולו בנוי עליו אינו נאכף כרגע.
      //
      // התיקון הוא פונקציית ענן שמחשבת זכאות בצד השרת ומחזירה את הקוד, ואז
      // השורה הזו הופכת ל-`if isManager(branchId)`.
      // DOCS/PLANING/15-the-code-is-not-enforced-yet.md
      match /accessCodes/{codeId} {
        allow read: if isActive(branchId);
        allow write: if isManager(branchId);
      }
    }

    // כל השאר סגור.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
