# Firebase web config. Firebase console, project settings, your web app.
# These are not secrets: security comes from firestore.rules, not from hiding them.
# They are kept out of the repository because the repository is public and the
# quota is worth protecting. DOCS/PLANING/08-the-repository-is-public.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
